  "content_rules": [
   {
    "id": "agent-pipe-to-shell",
    "title": "Downloads a script and runs it",
    "severity": "high",
    "regex": "(?i)\\b(curl|wget|iwr|invoke-webrequest)\\b[^\\n|]{0,300}\\|\\s*(sudo\\s+)?(ba|z|da|k|fi)?sh\\b|(?i)\\b(ba|z)?sh\\s+(-c\\s+)?[\\\"']?\\$\\(\\s*(curl|wget)\\b|(?i)\\b(ba|z)?sh\\s+<\\(\\s*(curl|wget)\\b|(?i)\\b(iex|invoke-expression)\\b[^\\n]{0,200}\\b(iwr|irm|invoke-webrequest|invoke-restmethod|downloadstring)\\b",
    "hint": "An agent that follows this file will download and run code from the internet. Remove it, or pin the script and check what it does.",
    "known_urls": "^https://(sh\\.rustup\\.rs|get\\.docker\\.com|get\\.sdkman\\.io|bun\\.sh|deno\\.land|astral\\.sh|install\\.python-poetry\\.org|get\\.pnpm\\.io|ohmyz\\.sh|starship\\.rs|tailscale\\.com|raw\\.githubusercontent\\.com/(Homebrew/install|nvm-sh/nvm|ohmyzsh/ohmyzsh))(/[^\\s]*)?$",
    "known_severity": "medium"
   },
   {
    "id": "agent-instruction-override",
    "title": "Tries to override the agent's instructions",
    "severity": "high",
    "regex": "(?i)\\b(ignore|disregard|forget|override)\\s+(all\\s+|any\\s+|the\\s+)?(previous|prior|above|earlier|preceding|system|original)\\s+(instructions|prompts?|rules|directions|guidelines)\\b|(?i)\\byou\\s+are\\s+now\\s+(in\\s+)?(developer|dan|jailbreak|god)\\s+mode\\b|(?i)\\bnew\\s+system\\s+prompt\\s*:",
    "hint": "Text like this is how prompt injection hijacks a coding agent. Find out who added it before you open this repo with an agent."
   },
   {
    "id": "agent-conceal-from-user",
    "title": "Tells the agent to hide what it does",
    "severity": "high",
    "regex": "(?i)\\b(do\\s+not|don'?t|never)\\s+(tell|inform|show|mention\\s+(this\\s+)?to|reveal\\s+(this\\s+)?to|alert|notify)\\s+(the\\s+)?(user|human|developer|operator)\\b|(?i)\\bwithout\\s+(telling|informing|asking|notifying)\\s+(the\\s+)?(user|human|developer)\\b|(?i)\\b(silently|secretly|quietly|covertly)\\s+(run|execute|send|upload|post|install|download|exfiltrate)\\b",
    "hint": "Legitimate instructions do not ask an agent to keep secrets from you. Treat the file as hostile until you know who wrote it."
   },
   {
    "id": "agent-exfil-endpoint",
    "title": "Points the agent at a data-collection endpoint",
    "severity": "high",
    "regex": "(?i)\\b(webhook\\.site|requestbin\\.(com|net)|pipedream\\.net|[a-z0-9-]+\\.m\\.pipedream\\.net|ngrok(-free)?\\.(io|app|dev)|ngrok\\.io|interact\\.sh|oast\\.(pro|live|site|online|fun|me)|burpcollaborator\\.net|canarytokens\\.com|transfer\\.sh|0x0\\.st|requestcatcher\\.com|beeceptor\\.com|hookbin\\.com|discord(app)?\\.com/api/webhooks|api\\.telegram\\.org/bot)\\b",
    "hint": "These services collect whatever is sent to them. An agent file that mentions one is a common way to leak code or keys. Check why it is there."
   },
   {
    "id": "agent-reads-credentials",
    "title": "Mentions credential files or key stores",
    "severity": "medium",
    "regex": "(?i)(~|\\$home|%userprofile%)?[/\\\\]\\.(ssh[/\\\\](id_[a-z0-9]+|authorized_keys)|aws[/\\\\]credentials|azure[/\\\\]|kube[/\\\\]config|docker[/\\\\]config\\.json|npmrc|pypirc|netrc|git-credentials|gnupg)\\b|(?i)\\b(security\\s+find-generic-password|keychain\\s+dump|cmdkey\\s+/list)\\b",
    "hint": "Agent instructions rarely need these files. If this asks the agent to read or send them, it is an attempt to steal credentials."
   },
   {
    "id": "agent-encoded-payload",
    "title": "Contains a long encoded blob",
    "severity": "medium",
    "confidence": "low",
    "regex": "[A-Za-z0-9+/]{240,}={0,2}|(?i)\\b(base64\\s+(-d|--decode)|frombase64string|atob\\s*\\()",
    "hint": "Encoded text in an agent file can hide instructions or a payload from a human reader. Decode it and check what it says."
   },
   {
    "id": "agent-hidden-comment-instructions",
    "title": "Hides instructions in an HTML comment",
    "severity": "medium",
    "confidence": "low",
    "kinds": [
     "instructions",
     "skill",
     "command"
    ],
    "regex": "(?is)<!--[^>]{0,1000}?\\b(ignore|instruction|you\\s+must|you\\s+are|system\\s+prompt|do\\s+not\\s+tell|assistant|agent)\\b[^>]{0,1000}?-->",
    "hint": "Comments are invisible when the file is rendered but an agent still reads them. Read the raw file."
   },
   {
    "id": "agent-auto-approve",
    "title": "Turns off the agent's permission prompts",
    "severity": "high",
    "kinds": [
     "settings",
     "mcp",
     "instructions",
     "command"
    ],
    "regex": "(?i)--dangerously-skip-permissions\\b|(?i)\\\"(dangerouslySkipPermissions|skipDangerousModePermissionPrompt)\\\"\\s*:\\s*true|(?i)\\\"(defaultMode)\\\"\\s*:\\s*\\\"bypassPermissions\\\"|(?i)\\\"(autoApprove|alwaysAllow)\\\"\\s*:\\s*(true|\\[\\s*\\\"\\*\\\")|(?i)\\\"chat\\.tools\\.(global\\.)?autoApprove\\\"\\s*:\\s*true|(?i)--(yolo|dangerously-bypass-approvals-and-sandbox)\\b|(?i)\\\"(approval_policy|approvalPolicy)\\\"\\s*[:=]\\s*\\\"never\\\"|(?i)approval_policy\\s*=\\s*\\\"never\\\"",
    "hint": "With prompts off, anything in the repo can make the agent run commands without asking you. Remove this setting from the repo."
   },
   {
    "id": "agent-broad-shell-permission",
    "title": "Allows any shell command without asking",
    "severity": "medium",
    "kinds": [
     "settings"
    ],
    "regex": "(?s)\"(allow|allowed_tools|allowedTools|autoApprove|alwaysAllow)\"\\s*:\\s*\\[[^\\]]{0,1000}?\"(Bash|Shell|run_shell_command|shell|bash|execute_command)(\\(\\s*\\*?\\s*(:\\s*\\*\\s*)?\\))?\"",
    "hint": "A repo should not pre-approve every shell command for the agent. Narrow it to the commands the project needs."
   },
   {
    "id": "agent-hook-network",
    "title": "A hook runs a network command automatically",
    "severity": "high",
    "kinds": [
     "settings"
    ],
    "regex": "(?is)\\\"hooks?\\\"\\s*:.{0,1000}?\\\"command\\\"\\s*:\\s*\\\"[^\\\"]{0,400}\\b(curl|wget|nc|ncat|netcat|socat|ssh|scp|iwr|invoke-webrequest)\\b",
    "hint": "Hooks run on their own whenever the agent acts. One that talks to the network can send your code or keys anywhere. Remove it unless you wrote it."
   },
   {
    "id": "agent-hidden-unicode",
    "title": "Contains invisible or direction-changing characters",
    "severity": "high",
    "regex": "[\\x{202A}-\\x{202E}\\x{2066}-\\x{2069}\\x{200B}-\\x{200D}\\x{2060}-\\x{2064}\\x{E0000}-\\x{E007F}]+",
    "hint": "Invisible characters can hide instructions that the agent reads but you do not see. Open the file in a hex viewer or strip them."
   }
  ]
 }
}
